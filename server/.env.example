# Copy to .env.development.local (local) or set in Vercel (production)
PORT=5500
SERVER_URL=http://localhost:5500
NODE_ENV=development

# MongoDB (the Vercel MongoDB Atlas integration sets MONGODB_URI instead)
DB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Arcjet (rate limiting + bot protection)
ARCJET_KEY=
ARCJET_ENV=development

# Upstash Workflow (renewal reminders). Run `npx @upstash/qstash-cli dev` for a local server.
QSTASH_URL=http://127.0.0.1:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Gmail app password for reminder emails
EMAIL_PASSWORD=
